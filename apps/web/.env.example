# Autenticación hacia el backend:
# Opción 1: Basic Auth (Codificado automáticamente en Base64 por el servidor)
APP_USERNAME=tu_usuario
APP_PASSWORD=tu_contraseña

# Opción 2: API Key o Bearer
# LIBROS_API_KEY=tu_api_key
# LIBROS_API_KEY_HEADER=x-api-key
# Configuración de escaneo de PDFs con MinerU
# Si no se define MINERU_API_URL, el backend utiliza el parser y adaptador local de Babilon.
MINERU_API_URL=http://localhost:8000
MINERU_API_KEY=

